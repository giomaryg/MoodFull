{
  "name": "MoodLog",
  "type": "object",
  "properties": {
    "mood": {
      "type": "string",
      "description": "User's current mood"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "mood"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    }
  }
}